# WorkFlowOS - Staging Environment Configuration
# Copy to .env.staging and set real secrets in the deploy environment.

# === Database ===
DATABASE_URL="postgresql://workflowos:CHANGE_ME@db-host:5432/workflowos"

# === Redis (optional, for future rate-limit/store) ===
REDIS_URL="redis://redis-host:6379"

# === JWT ===
JWT_ACCESS_SECRET="CHANGE_ME_64_chars_random"
JWT_REFRESH_SECRET="CHANGE_ME_64_chars_random"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# === Server ===
API_PORT=3001
WEB_PORT=3000
NODE_ENV=staging
LOG_LEVEL=info

# === CORS ===
WEB_URL="https://staging.workflowos.example.com"

# === Rate limiting (staging: lower to catch abuse) ===
THROTTLE_TTL=60000
THROTTLE_LIMIT=60